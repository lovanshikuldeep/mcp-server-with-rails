<% content_for :title, "Blog" %>

<div class="header">
  <h1>Blog Posts</h1>
  <%= link_to "New post", new_post_path, class: "btn" %>
</div>

<p class="notice"><%= notice %></p>

<div id="posts">
  <% if @posts.empty? %>
    <p>No posts yet. <%= link_to "Write the first one", new_post_path %>.</p>
  <% end %>

  <% @posts.each do |post| %>
    <article class="card" id="<%= dom_id post %>">
      <h2><%= link_to post.title, post %></h2>
      <small><%= l post.created_at, format: :long %></small>
      <p><%= truncate(post.body, length: 200) %></p>
      <div class="actions">
        <%= link_to "Show", post %>
        <%= link_to "Edit", edit_post_path(post) %>
        <%= button_to "Delete", post, method: :delete, class: "link-danger",
              form: { data: { turbo_confirm: "Delete this post?" } } %>
      </div>
    </article>
  <% end %>
</div>
