<%= form_with(model: post) do |form| %>
  <% if post.errors.any? %>
    <div class="errors">
      <strong><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</strong>
      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div class="field">
    <%= form.label :body %>
    <%= form.textarea :body %>
  </div>

  <div class="field">
    <%= form.submit %>
  </div>
<% end %>
